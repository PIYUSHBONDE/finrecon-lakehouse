{
  "name": "postgres-ledger-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "plugin.name": "pgoutput",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "finrecon",
    "database.password": "finrecon",
    "database.dbname": "finrecon",
    "topic.prefix": "finrecon_db",
    "table.include.list": "public.accounts,public.invoices,public.ledger_entries",
    "publication.autocreate.mode": "filtered",
    "decimal.handling.mode": "string"
  }
}
